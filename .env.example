# Browser-visible Supabase project settings. These values are safe to ship in a client app.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only event provider keys. Do not prefix these with VITE_.
TICKETMASTER_API_KEY=
NPS_API_KEY=

# ElevenLabs Conversational AI voice guide. Keep the API key server-side.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Google Cloud Translation API key; keep server-side and restrict it to Translation API.
# Cloud Translation requires billing. Set a usage quota before enabling this key.
GOOGLE_TRANSLATE_API_KEY=
